{
	"name": "xmlconverter",
	"version": "1.0.0",
	"description": "This plugin converts various XML formats and supports interoperability between publication systems",
	"main": "index.js",
	"scripts": {
		"build": "npm run build:default && npm run build:conversions",
		"build:default": "vite build --emptyOutDir false --config vite.config.default.js",
		"build:conversions": "vite build --emptyOutDir false --config vite.config.conversions.js",
		"dev:default": "vite build --watch --mode development --emptyOutDir false --config vite.config.default.js",
		"dev:conversions": "vite build --watch --mode development --emptyOutDir false --config vite.config.conversions.js",
		"lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --fix --ignore-path .gitignore"
	},
	"author": "",
	"license": "GPL-3",
	"devDependencies": {
		"@rushstack/eslint-patch": "^1.10.5",
		"@vitejs/plugin-vue": "^5.2.1",
		"@vue/eslint-config-prettier": "^10.2.0",
		"eslint": "^9.20.0",
		"eslint-plugin-vue": "^9.32.0",
		"prettier": "^3.5.0",
		"vite": "^6.1.0"
	}
}
